# Copy to .env and fill in real values. NEVER commit .env.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Text model chain (first healthy wins) ---
LOCAL_TEXT_URL=http://127.0.0.1:8141/v1
LOCAL_TEXT_MODEL=muse-glimmer-30b
LOCAL_TEXT_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/v1

# --- Vision model chain (first healthy wins) ---
LOCAL_VISION_URL=http://127.0.0.1:8109/v1
LOCAL_VISION_MODEL=qwen3.8-27b-uncensored
LOCAL_VISION_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_URL=https://api.openai.com/v1

# --- Memory (Hindsight REST) ---
HINDSIGHT_BANK_URL=http://127.0.0.1:8897/v1/default/banks/safety

# --- Paths (container defaults) ---
KNOWLEDGE_DIR=/app/knowledge
DATA_DIR=/app/data
SYSTEM_PROMPT_PATH=/app/system_prompt.txt

# --- Tuneables (optional) ---
# TEXT_TIMEOUT_S=180
# VISION_TIMEOUT_S=180
# TEXT_MAX_TOKENS=1800
# VISION_MAX_TOKENS=1400
# BACKOFF_S=300
# RETRIEVE_TOP_K=6
# RECALL_TIMEOUT_S=12
